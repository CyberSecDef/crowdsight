# Secrets and local config
.env
.env.*
!.env.example

# Runtime data — uploaded source documents, graphs, run state, generated reports.
# The four directories are tracked (via .gitkeep) so a fresh clone has the
# skeleton; everything that lands inside them is ignored.
data/*
!data/uploads/
!data/graphs/
!data/simulations/
!data/reports/
data/*/*
!data/*/.gitkeep

*.db
*.sqlite
*.sqlite3

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node / frontend
node_modules/
dist/
.vite/
npm-debug.log*

# Editors and OS
.vscode/
.idea/
.DS_Store
*.swp
