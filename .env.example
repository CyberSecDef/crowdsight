# CrowdSight configuration
#
# Copy to .env and adjust. Defaults are already local-only — the only value you
# MUST set is NEO4J_PASSWORD.
#
# Config.validate() refuses to start if LLM_BASE_URL, EMBEDDING_BASE_URL, or
# NEO4J_URI point at a host outside the allowlist. Pointing any of these off-box
# is a defect, not a configuration option.

# --- Inference (local Ollama) ------------------------------------------------
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL_NAME=qwen2.5:14b
# Required by the OpenAI SDK, which rejects an empty string. Not a credential —
# nothing authenticates against it. Leave as the literal "ollama".
LLM_API_KEY=ollama
# Ollama serialises requests internally; above ~4 throughput degrades and the
# GPU can OOM. Tune deliberately, don't raise blindly.
LLM_CONCURRENCY=4

# --- Embeddings (local Ollama) -----------------------------------------------
EMBEDDING_BASE_URL=http://ollama:11434
EMBEDDING_MODEL=nomic-embed-text

# --- Knowledge graph (local Neo4j) -------------------------------------------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Simulation limits -------------------------------------------------------
MAX_ROUNDS=10
MAX_AGENTS=100

# --- Report generation -------------------------------------------------------
REPORT_TEMPERATURE=0.5

# --- Document ingestion ------------------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_CONTENT_LENGTH=52428800
ALLOWED_EXTENSIONS=pdf,md,txt,markdown

# --- Egress allowlist --------------------------------------------------------
# localhost, 127.0.0.1, ollama, and neo4j are always permitted. Add extra
# hostnames here only if you have moved a service to another box on your LAN,
# and understand that doing so widens the sealed perimeter.
ALLOWED_HOSTS=
