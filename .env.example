# CrowdSight configuration
#
# Copy to .env and adjust. Defaults are already local-only — the only value you
# MUST set is NEO4J_PASSWORD.
#
# CrowdSight refuses to start if LLM_BASE_URL, EMBEDDING_BASE_URL, or NEO4J_URI
# point at a public host. The order of preference is:
#
#   1. Compose service names (ollama, neo4j) — the default, and best.
#   2. Loopback (localhost, 127.0.0.1, ::1) — equally good outside Compose.
#   3. Private LAN addresses (10.x, 172.16-31.x, 192.168.x, 169.254.x, fd00::/8)
#      — permitted where genuinely needed, e.g. Ollama on a separate GPU box.
#      Each one logs a warning at startup: traffic to another machine still
#      leaves this host, and the container egress seal cannot cover it.
#   4. Anything public — refused.

# --- Inference (local Ollama) ------------------------------------------------
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL_NAME=qwen2.5:14b
# Required by the OpenAI SDK, which rejects an empty string. Ollama ignores the
# value, so the default is inert and not a credential. Set it only if you run a
# local OpenAI-compatible gateway (LiteLLM, vLLM) that wants a real token.
LLM_API_KEY=ollama
# Ollama serialises requests internally; above ~4 throughput degrades and the
# GPU can OOM. Tune deliberately, don't raise blindly.
#
# This bound is PER PROCESS. Phase 6 runs each simulation in its own OS
# process and divides this budget across them, so two concurrent runs get 2
# each rather than 4 each. Raising it here raises the total.
LLM_CONCURRENCY=4

# Generation legitimately takes minutes on local hardware; connecting does not.
# A single timeout covering both would turn "Ollama is down" into a long hang.
LLM_TIMEOUT=300
LLM_CONNECT_TIMEOUT=10

# Transient failures only — a connection reset, a read timeout, a 5xx while the
# model loads into VRAM. A bad request is never retried. Backoff is
# exponential with full jitter, so a restart does not produce a thundering herd.
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY=1.0
LLM_RETRY_MAX_DELAY=30.0

# --- Embeddings (local Ollama) -----------------------------------------------
EMBEDDING_BASE_URL=http://ollama:11434
EMBEDDING_MODEL=nomic-embed-text

# Declared, not inferred. If you change EMBEDDING_MODEL you must change this to
# match, and you should prune the cache — vectors of different dimensionality
# cannot be compared, and a stale hit would be silently meaningless.
EMBEDDING_DIM=768

# One request carries this many texts. /api/embed batches server-side.
EMBEDDING_BATCH_SIZE=32

# Re-embedding unchanged text across runs is pure waste. Keyed by a hash of
# model, dimension and text, so changing models misses rather than colliding.
EMBEDDING_CACHE_PATH=data/cache/embeddings.db
EMBEDDING_CACHE_ENABLED=true

# --- Knowledge graph (local Neo4j) -------------------------------------------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Simulation limits -------------------------------------------------------
MAX_ROUNDS=10
MAX_AGENTS=100

# --- Report generation -------------------------------------------------------
REPORT_TEMPERATURE=0.5

# --- Document ingestion ------------------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_CONTENT_LENGTH=52428800
ALLOWED_EXTENSIONS=pdf,md,txt,markdown

# --- Egress allowlist --------------------------------------------------------
# Loopback, the service names ollama/neo4j, and private LAN addresses are
# permitted without listing them here. This is only for extra *hostnames* —
# a machine you refer to by name rather than by IP. Hostnames are never
# resolved during validation, so listing one means trusting your DNS.
ALLOWED_HOSTS=
